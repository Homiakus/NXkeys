<UserControl x:Class="NxEskd.Configurator.PmiBomSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#D8DEE6"
                BorderThickness="0,0,0,1" Padding="14,11">
            <StackPanel>
                <TextBlock Text="PMI, спецификация и позиции" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Настройки соответствуют реально исполняемым контрактам NX Runtime"
                           Foreground="#667085" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" BorderThickness="0">
            <TabItem Header="PMI">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#D8DEE6" BorderThickness="1" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <CheckBox Content="Наследовать PMI из model views"
                                          IsChecked="{Binding PmiEnabled, Mode=TwoWay}" FontWeight="SemiBold"/>
                                <TextBlock Text="Политика orphan PMI" Margin="0,14,0,4" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding OrphanPolicies}"
                                          SelectedItem="{Binding OrphanPmiPolicy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <CheckBox Content="Требовать ассоциативность"
                                          IsChecked="{Binding AssociativityRequired, Mode=TwoWay}" Margin="0,0,0,6"/>
                                <CheckBox Content="Сохранять связь с источником"
                                          IsChecked="{Binding KeepSourceLink, Mode=TwoWay}" Margin="0,0,0,6"/>
                                <CheckBox Content="Обновлять при изменении модели"
                                          IsChecked="{Binding UpdateWhenModelChanges, Mode=TwoWay}" Margin="0,0,0,10"/>
                                <TextBlock Text="При потере ассоциации" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding LostAssociationPolicies}"
                                          SelectedItem="{Binding OnLostAssociation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Сопоставление model view → drawing view" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Каждая строка определяет источник PMI для конкретного вида чертежа"
                                       Foreground="#667085" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Добавить mapping" Click="AddMapping_Click" Padding="12,6" Margin="3,0"/>
                            <Button Content="Удалить mapping" Click="RemoveMapping_Click" Padding="12,6" Margin="3,0"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="MappingsGrid" Grid.Row="4"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Model view" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding ModelViewCandidates}"
                                                  SelectedItem="{Binding SourceModelView, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Fallback model view" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding ModelViewCandidates}"
                                                  SelectedItem="{Binding FallbackSourceModelView, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Drawing view" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DrawingViewCandidates}"
                                                  SelectedItem="{Binding TargetDrawingViewId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Допуск ориентации, °"
                                                Binding="{Binding OrientationToleranceDeg, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Спецификация и позиции">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#D8DEE6" BorderThickness="1" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <CheckBox Content="Формировать Parts List"
                                          IsChecked="{Binding PartsListEnabled, Mode=TwoWay}" FontWeight="SemiBold"/>
                                <TextBlock Text="BOM mode" Margin="0,12,0,4" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding BomModes}"
                                          SelectedItem="{Binding BomMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Уровни" Margin="0,10,0,4" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding LevelModes}"
                                          SelectedItem="{Binding LevelMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Количество" Margin="0,10,0,4" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding QuantityModes}"
                                          SelectedItem="{Binding QuantityMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <CheckBox Content="Объединять идентичные компоненты"
                                          IsChecked="{Binding MergeIdentical, Mode=TwoWay}" Margin="0,0,0,8"/>
                                <CheckBox Content="Сохранять существующие позиции"
                                          IsChecked="{Binding PreserveExistingPositions, Mode=TwoWay}" Margin="0,0,0,12"/>
                                <TextBlock Text="Начальная позиция" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding PositionStart, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,10"/>
                                <TextBlock Text="Шаг нумерации" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding PositionIncrement, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <CheckBox Content="Формировать позиции"
                                          IsChecked="{Binding BalloonsEnabled, Mode=TwoWay}" FontWeight="SemiBold"/>
                                <TextBlock Text="Форма" Margin="0,12,0,4" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding BalloonShapes}"
                                          SelectedItem="{Binding BalloonShape, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <CheckBox Content="Группировать одинаковые компоненты"
                                          IsChecked="{Binding GroupIdenticalComponents, Mode=TwoWay}" Margin="0,12,0,5"/>
                                <CheckBox Content="Избегать пересечения выносок"
                                          IsChecked="{Binding AvoidCrossingLeaders, Mode=TwoWay}" Margin="0,5"/>
                                <CheckBox Content="Избегать геометрии"
                                          IsChecked="{Binding AvoidGeometry, Mode=TwoWay}" Margin="0,5"/>
                                <TextBlock Text="Минимальный зазор, мм" Margin="0,10,0,4" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding MinimumBalloonGapMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Колонки спецификации" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Runtime записывает только поддерживаемые источники значений"
                                       Foreground="#667085" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Добавить" Click="AddColumn_Click" Padding="12,6" Margin="3,0"/>
                            <Button Content="Вверх" Click="MoveColumnUp_Click" Padding="12,6" Margin="3,0"/>
                            <Button Content="Вниз" Click="MoveColumnDown_Click" Padding="12,6" Margin="3,0"/>
                            <Button Content="Удалить" Click="RemoveColumn_Click" Padding="12,6" Margin="3,0"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="ColumnsGrid" Grid.Row="4"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="1.2*"/>
                            <DataGridTextColumn Header="Заголовок" Binding="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="2*"/>
                            <DataGridTemplateColumn Header="Источник" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Sources}"
                                                  SelectedItem="{Binding Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ширина, мм"
                                                Binding="{Binding WidthMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
