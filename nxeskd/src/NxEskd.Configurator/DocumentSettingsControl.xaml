<UserControl x:Class="NxEskd.Configurator.DocumentSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" BorderBrush="#D8DEE6" BorderThickness="1" Padding="18">
                <StackPanel>
                    <TextBlock Text="Документ" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Данные основной надписи и тип документа" Foreground="#667085" Margin="0,3,0,16"/>

                    <TextBlock Text="Тип документа" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding DocumentKinds}"
                              SelectedItem="{Binding DocumentKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,5,0,12"/>
                    <TextBlock Text="Обозначение" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Designation, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,12"/>
                    <TextBlock Text="Наименование" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,12"/>
                    <TextBlock Text="Ревизия / изменение" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Revision, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,12"/>
                    <TextBlock Text="Организация" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Organization, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,12"/>
                    <TextBlock Text="Материал" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Material, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,12"/>
                    <TextBlock Text="Статус документа" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,12"/>
                    <TextBlock Text="Определение основной надписи" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding TitleBlockDefinitions}"
                              SelectedItem="{Binding ActiveTitleBlock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" BorderBrush="#D8DEE6" BorderThickness="1" Padding="18">
                <StackPanel>
                    <TextBlock Text="Ответственные" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Подписи и роли в основной надписи" Foreground="#667085" Margin="0,3,0,16"/>

                    <TextBlock Text="Разработал" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding DevelopedBy, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,12"/>
                    <TextBlock Text="Проверил" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding CheckedBy, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,12"/>
                    <TextBlock Text="Нормоконтроль" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding NormControlBy, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,12"/>
                    <TextBlock Text="Утвердил" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding ApprovedBy, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,18"/>

                    <TextBlock Text="Защита ручной работы" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,10"/>
                    <CheckBox Content="Сохранять ручные позиции видов"
                              IsChecked="{Binding PreserveManualViewPositions, Mode=TwoWay}" Margin="0,4"/>
                    <CheckBox Content="Сохранять ручные размеры"
                              IsChecked="{Binding PreserveManualDimensions, Mode=TwoWay}" Margin="0,4"/>
                    <CheckBox Content="Сохранять ручные примечания"
                              IsChecked="{Binding PreserveManualNotes, Mode=TwoWay}" Margin="0,4"/>
                    <CheckBox Content="Dry run — не изменять NX"
                              IsChecked="{Binding DryRun, Mode=TwoWay}" Margin="0,12,0,4"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="#D8DEE6" BorderThickness="1" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Нативный PRT" FontSize="16" FontWeight="SemiBold"/>
                        <CheckBox Content="Сохранять WorkPart" IsChecked="{Binding SavePart, Mode=TwoWay}" Margin="0,10,0,8"/>
                        <CheckBox Content="Использовать отдельный выходной PRT"
                                  IsChecked="{Binding NativeDrawingEnabled, Mode=TwoWay}" Margin="0,4,0,8"/>
                        <TextBlock Text="Режим сохранения" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding SaveModes}"
                                  SelectedItem="{Binding SaveMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,5,0,10"/>
                        <TextBlock Text="Файл .prt" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NativeDrawingFile, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PDF" FontSize="16" FontWeight="SemiBold"/>
                        <CheckBox Content="Формировать PDF" IsChecked="{Binding PdfEnabled, Mode=TwoWay}" Margin="0,10,0,8"/>
                        <TextBlock Text="Выходной файл" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding PdfFile, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,0"/>
                        <TextBlock Text="PDF создаётся только после успешной NX-проверки и сохранения PRT."
                                   Foreground="#667085" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="DXF развертки" FontSize="16" FontWeight="SemiBold"/>
                        <CheckBox Content="Формировать DXF" IsChecked="{Binding DxfEnabled, Mode=TwoWay}" Margin="0,10,0,8"/>
                        <TextBlock Text="Выходной файл" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding DxfFile, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,0"/>
                        <TextBlock Text="Доступно для подтверждённой листовой детали и управляемого Flat Pattern."
                                   Foreground="#667085" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4" Grid.ColumnSpan="3" Background="#FFF7ED"
                    BorderBrush="#FDBA74" BorderThickness="1" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Опасные операции с PRT" FontSize="16" FontWeight="SemiBold" Foreground="#9A3412"/>
                        <TextBlock Text="Разрешения действуют только после Preview и дополнительного подтверждения перед запуском."
                                   TextWrapping="Wrap" Foreground="#9A3412" Margin="0,4,0,12"/>
                        <CheckBox Content="Разрешить перезапись существующего выходного PRT"
                                  IsChecked="{Binding AllowOverwriteExisting, Mode=TwoWay}" Margin="0,5"/>
                        <CheckBox Content="Разрешить перезапись выпущенного или утверждённого документа"
                                  IsChecked="{Binding AllowOverwriteReleasedDocument, Mode=TwoWay}" Margin="0,5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Удаление управляемых объектов" FontSize="16" FontWeight="SemiBold" Foreground="#9A3412"/>
                        <TextBlock Text="Runtime удаляет только объекты текущего profile/scope; ручные и legacy-объекты не присваиваются."
                                   TextWrapping="Wrap" Foreground="#9A3412" Margin="0,4,0,12"/>
                        <CheckBox Content="Удалять managed-объекты, отсутствующие в профиле"
                                  IsChecked="{Binding DeleteManagedObjectsMissingFromConfig, Mode=TwoWay}" Margin="0,5"/>
                        <CheckBox Content="Подтверждаю удаление stale-объектов после Preview"
                                  IsChecked="{Binding ConfirmManagedDeletion, Mode=TwoWay}" Margin="0,5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
