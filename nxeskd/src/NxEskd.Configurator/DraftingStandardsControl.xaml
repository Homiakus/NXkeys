<UserControl x:Class="NxEskd.Configurator.DraftingStandardsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#D8DEE6"
                BorderThickness="0,0,0,1" Padding="14,11">
            <StackPanel>
                <TextBlock Text="Стандарты оформления и шаблоны" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Параметры, которые участвуют в planning, layout, validation и NX Drafting"
                           Foreground="#667085" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" BorderThickness="0">
            <TabItem Header="Размеры и компоновка">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20" MaxWidth="1100" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="500"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="500"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#D8DEE6" BorderThickness="1" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Размеры и штриховка" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Runtime подтверждает применение каждого параметра или создаёт warning."
                                           Foreground="#667085" TextWrapping="Wrap" Margin="0,4,0,16"/>

                                <TextBlock Text="Метод проекций" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding ProjectionMethods}"
                                          SelectedItem="{Binding ProjectionMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,5,0,12"/>
                                <TextBlock Text="Длина стрелки, мм" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding ArrowLengthMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,12"/>
                                <TextBlock Text="Отступ первого размера, мм" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding FirstDimensionOffsetMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,12"/>
                                <TextBlock Text="Шаг параллельных размеров, мм" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding ParallelDimensionGapMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,12"/>
                                <TextBlock Text="Угол штриховки, °" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding HatchingAngleDeg, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,12"/>
                                <TextBlock Text="Шаг штриховки, мм" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding HatchingSpacingMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" BorderBrush="#D8DEE6" BorderThickness="1" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Компоновка и масштабы" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Используется автоматическим layout solver до создания видов."
                                           Foreground="#667085" TextWrapping="Wrap" Margin="0,4,0,16"/>

                                <TextBlock Text="Минимальный зазор между объектами, мм" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding MinimumGapMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,12"/>
                                <TextBlock Text="Максимум итераций layout solver" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding MaxLayoutIterations, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,12"/>
                                <TextBlock Text="Допустимые масштабы" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding AllowedScales, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         AcceptsReturn="True" MinHeight="92" TextWrapping="Wrap" Margin="0,5,0,8"/>
                                <TextBlock Text="Разделители: запятая, точка с запятой или новая строка. Например: 1:1, 1:2, 1:5."
                                           Foreground="#667085" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Текстовые стили">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Текстовые стили" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Высота менее 2,5 мм блокируется validation-политикой профиля."
                                       Foreground="#667085" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Добавить" Click="AddTextStyle_Click" Padding="12,6" Margin="3,0"/>
                            <Button Content="Удалить" Click="RemoveTextStyle_Click" Padding="12,6" Margin="3,0"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid x:Name="TextStylesGrid" Grid.Row="2"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="1.4*"/>
                            <DataGridTextColumn Header="Шрифт" Binding="{Binding Font, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="2*"/>
                            <DataGridTextColumn Header="Высота, мм" Binding="{Binding HeightMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="120"/>
                            <DataGridTextColumn Header="Коэффициент ширины" Binding="{Binding WidthFactor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="150"/>
                            <DataGridCheckBoxColumn Header="Жирный" Binding="{Binding Bold, Mode=TwoWay}" Width="90"/>
                            <DataGridCheckBoxColumn Header="Курсив" Binding="{Binding Italic, Mode=TwoWay}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="PRT-шаблоны">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Каталог PRT-шаблонов" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Лист создаётся только из существующего шаблона; fallback на пустой лист запрещён."
                                       Foreground="#667085" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Добавить шаблон" Click="AddTemplate_Click" Padding="12,6" Margin="3,0"/>
                            <Button Content="Удалить шаблон" Click="RemoveTemplate_Click" Padding="12,6" Margin="3,0"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid x:Name="TemplatesGrid" Grid.Row="2"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="1.4*"/>
                            <DataGridTextColumn Header="Файл" Binding="{Binding File, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="3*"/>
                            <DataGridTemplateColumn Header="Формат" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Formats}"
                                                  SelectedItem="{Binding Format, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Ориентация" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Orientations}"
                                                  SelectedItem="{Binding Orientation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Рамка" Binding="{Binding BorderObjectName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="1.5*"/>
                            <DataGridTextColumn Header="Основная надпись" Binding="{Binding TitleBlockObjectName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="1.6*"/>
                            <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
