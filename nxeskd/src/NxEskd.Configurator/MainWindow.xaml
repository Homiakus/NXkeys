<Window x:Class="NxEskd.Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NxEskd.Configurator"
        Title="NX 2512 — ЕСКД генератор чертежей"
        Height="900" Width="1540" MinHeight="700" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        Closing="MainWindow_Closing"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE6"/>
        <SolidColorBrush x:Key="TextBrush" Color="#17202A"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#667085"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#185ABD"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#114A9E"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#B42318"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#B54708"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="Button" x:Key="ToolbarButton">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF3F9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E9EDF2"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>

        <DataTemplate x:Key="TextSettingEditor">
            <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     ToolTip="{Binding Description}"/>
        </DataTemplate>

        <DataTemplate x:Key="ChoiceSettingEditor">
            <ComboBox ItemsSource="{Binding AllowedValues}"
                      SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="{Binding Description}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="NX ESKD" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Настройка и выпуск чертежей" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Активный профиль" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBox x:Name="ProfilePathBox" Grid.Row="1" IsReadOnly="True"
                             Background="#F8FAFC" Margin="0,4,0,0"/>
                </Grid>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Открыть" Click="OpenProfile_Click" Style="{StaticResource ToolbarButton}"/>
                    <Button Content="Сохранить" Click="Save_Click" Style="{StaticResource ToolbarButton}"/>
                    <Button Content="Сохранить как" Click="SaveAs_Click" Style="{StaticResource ToolbarButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Разделы профиля" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Выберите область настройки или найдите параметр"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" Margin="0,3,0,12"/>
                        <TextBox x:Name="SectionSearchBox" Margin="0,0,0,10"
                                 ToolTip="Поиск раздела"
                                 TextChanged="SectionSearchBox_TextChanged"/>
                    </StackPanel>
                    <TreeView x:Name="SectionsTree"
                              Background="Transparent" BorderThickness="0"
                              SelectedItemChanged="SectionsTree_SelectedItemChanged"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#E5E9EF" ShowsPreview="True"/>

            <Border Grid.Column="2" Margin="14" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TabControl x:Name="MainTabs" Background="White" BorderThickness="0" Padding="0">
                    <TabItem Header="Документ и выпуск">
                        <local:DocumentSettingsControl x:Name="DocumentSettingsEditor"/>
                    </TabItem>
                    <TabItem Header="Листы и виды">
                        <local:DrawingStructureControl x:Name="DrawingStructureEditor"/>
                    </TabItem>
                    <TabItem Header="Технические требования">
                        <local:TechnicalRequirementsControl x:Name="TechnicalRequirementsEditor"/>
                    </TabItem>
                    <TabItem Header="Настройки">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F8FAFC"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="14,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Параметры раздела" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="Изменения сразу проходят типовую проверку"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>
                                    <TextBox x:Name="SettingSearchBox" Grid.Column="1" Width="360"
                                             HorizontalAlignment="Right" VerticalAlignment="Center"
                                             ToolTip="Поиск по имени, пути, описанию или значению"
                                             TextChanged="SettingSearchBox_TextChanged"/>
                                </Grid>
                            </Border>

                            <DataGrid x:Name="SettingsGrid" Grid.Row="1"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserDeleteRows="False" IsReadOnly="False"
                                      SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Параметр" Binding="{Binding Name}"
                                                        Width="190" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}"
                                                        Width="2.3*" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="Значение" Width="1.5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Setter Property="ContentTemplate"
                                                                    Value="{StaticResource TextSettingEditor}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAllowedValues}" Value="True">
                                                                    <Setter Property="ContentTemplate"
                                                                            Value="{StaticResource ChoiceSettingEditor}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="JSON path" Binding="{Binding Path}"
                                                        Width="1.5*" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="JSON — расширенный режим">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Исходный профиль" FontWeight="SemiBold"/>
                                        <TextBlock Text="Используйте для редких и экспериментальных параметров"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Применить и проверить" Click="ApplyRawJson_Click"
                                                Style="{StaticResource ToolbarButton}"/>
                                        <Button Content="Восстановить из формы" Click="RefreshRawJson_Click"
                                                Style="{StaticResource ToolbarButton}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBox x:Name="RawJsonBox" Grid.Row="1"
                                     Margin="0" Padding="14"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" BorderThickness="0"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Проверка">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="14,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Готовность профиля" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ValidationSummaryText"
                                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Проверить сейчас"
                                            Click="ValidateProfile_Click"
                                            Style="{StaticResource ToolbarButton}"/>
                                </Grid>
                            </Border>
                            <DataGrid x:Name="IssuesGrid" Grid.Row="1"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Уровень" Binding="{Binding Severity}" Width="125"/>
                                    <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="220"/>
                                    <DataGridTextColumn Header="Объект" Binding="{Binding ObjectId}" Width="170"/>
                                    <DataGridTextColumn Header="JSON path" Binding="{Binding JsonPath}" Width="260"/>
                                    <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Справка">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="26" MaxWidth="900" HorizontalAlignment="Left">
                                <TextBlock Text="Рабочий процесс" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,10,0,20" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Configurator редактирует профиль вне процесса NX. Перед передачей команды профиль полностью разбирается, проверяется и сохраняется атомарно с резервной копией."/>

                                <TextBlock Text="1. Настройте документ" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,5,0,15" TextWrapping="Wrap"
                                           Text="Используйте типизированные поля. Неподдерживаемые типы видов отсутствуют в списке и не подменяются базовым видом."/>

                                <TextBlock Text="2. Проверьте профиль" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,5,0,15" TextWrapping="Wrap"
                                           Text="Ошибки блокируют сохранение и выполнение. Предупреждения и ManualReview требуют инженерной оценки."/>

                                <TextBlock Text="3. Выполните Preview" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,5,0,15" TextWrapping="Wrap"
                                           Text="Preview строит план операций без изменения WorkPart. После этого можно запускать Generate или Update."/>

                                <TextBlock Text="4. Проверьте результат в NX" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,5,0,15" TextWrapping="Wrap"
                                           Text="Рамка, основная надпись, виды, PMI, таблицы и экспорт подтверждаются postcondition-проверками. При ошибке NX-транзакция откатывается."/>

                                <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1"
                                        Padding="14" Margin="0,12,0,0">
                                    <TextBlock TextWrapping="Wrap"
                                               Text="Для запуска внешнего Configurator WorkPart должен быть сохранён. Это защищает от применения запроса к другой детали после переключения окна NX."/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Готово"
                           Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Диагностика API" Click="Inventory_Click"
                            Style="{StaticResource ToolbarButton}"/>
                    <Button Content="Preview" Click="Preview_Click"
                            Style="{StaticResource ToolbarButton}"/>
                    <Button Content="Проверить в NX" Click="ValidateNx_Click"
                            Style="{StaticResource ToolbarButton}"/>
                    <Button Content="Обновить" Click="Update_Click"
                            Style="{StaticResource ToolbarButton}"/>
                    <Button Content="Сформировать чертёж" Click="Generate_Click"
                            Style="{StaticResource PrimaryButton}" Margin="10,0,3,0"/>
                    <Button Content="Закрыть" Click="Close_Click"
                            Style="{StaticResource ToolbarButton}" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
