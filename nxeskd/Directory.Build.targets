<Project>
  <PropertyGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-windows'))">
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <Target Name="ValidateNxReferenceIsolation"
          BeforeTargets="ResolveReferences"
          Condition="'$(RequiresNxOpen)' == 'true'">
    <Error Condition="'$(NxOpenManagedDir)' == ''"
           Text="NxOpenManagedDir is required for this NX integration project. Use scripts/build.ps1 -NxRoot &lt;NX2512&gt;." />
    <Error Condition="!Exists('$(NxOpenManagedDir)\NXOpen.dll')"
           Text="NXOpen.dll was not found in $(NxOpenManagedDir)." />
    <Error Condition="!Exists('$(NxOpenManagedDir)\NXOpen.UF.dll')"
           Text="NXOpen.UF.dll was not found in $(NxOpenManagedDir)." />
  </Target>
</Project>
